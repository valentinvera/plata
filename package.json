{
  "name": "plata",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^18.0.6",
      "zod": "^4.6.5",
      "@types/bun": "^1.4.2",
      "varlock": "1.21.1",
      "@trpc/server": "^11.19.0",
      "better-auth": "1.7.7",
      "@tanstack/react-query": "^5.104.1",
      "lucide-react": "^1.53.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@trpc/tanstack-react-query": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "@tanstack/react-form": "^1.33.5",
      "@types/react-dom": "^19.2.7",
      "@better-auth/expo": "1.7.7",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "scripts": {
    "auth:generate": "cd apps/api && bun run auth:generate",
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @plata/db --",
    "db:migrate": "turbo run db:migrate -F @plata/db --",
    "db:migrate:deploy": "turbo run db:migrate:deploy -F @plata/db --",
    "db:push": "turbo run db:push -F @plata/db --",
    "db:studio": "turbo run db:studio -F @plata/db --",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev -F @plata/api --",
    "dev:mobile": "turbo run dev -F @plata/mobile --",
    "dev:web": "turbo run dev -F @plata/web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/api/ && varlock codegen --path ./apps/mobile/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/api/ && varlock codegen --path ./apps/mobile/ && varlock codegen --path ./packages/db/",
    "test": "turbo run test"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@plata/ts-config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "2.2.1",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  }
}
