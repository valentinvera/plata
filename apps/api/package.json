{
  "name": "@plata/api",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile api",
    "dev": "bun run --hot src/index.ts",
    "env:generate": "varlock codegen",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@plata/auth": "workspace:*",
    "@plata/db": "workspace:*",
    "@plata/trpc": "workspace:*",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "hono": "^4.13.13",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@plata/ts-config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
