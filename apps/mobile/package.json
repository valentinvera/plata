{
  "name": "@plata/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "check-types": "tsc --noEmit",
    "dev": "expo start --clear",
    "eas": "bun --env-file=.env node_modules/.bin/eas",
    "eas:build": "bun run eas -- build --profile production",
    "eas:build:android": "bun run eas -- build --platform android --profile production",
    "eas:build:ios": "bun run eas -- build --platform ios --profile production",
    "eas:config": "bun run eas -- config --non-interactive",
    "eas:init": "bun run eas -- init --account valenvera-team --non-interactive",
    "eas:update": "bun run eas -- update",
    "eas:update:configure": "bun run eas -- update:configure --non-interactive",
    "eas:update:preview": "bun run eas -- update --channel preview --environment preview",
    "eas:update:production": "bun run eas -- update --channel production --environment production",
    "env:generate": "varlock codegen",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prod": "expo export",
    "start": "expo start",
    "test": "bun test --pass-with-no-tests",
    "web": "expo start --web"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@plata/trpc": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "@varlock/expo-integration": "1.2.1",
    "better-auth": "catalog:",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-share-intent": "^8.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.2",
    "heroui-native": "^1.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-notification-listener": "5.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "catalog:",
    "uniwind": "^1.12.2",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@plata/ts-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.14",
    "bun-types": "1.4.2",
    "eas-cli": "^24.12.0",
    "typescript": "~7.0.2"
  }
}
